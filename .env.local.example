# Copy this file to .env.local and fill in real values once each service is connected.
# Never commit .env.local — it is already covered by .gitignore.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cal.com webhook ---
CAL_COM_WEBHOOK_SECRET=

# --- OpenAI (server-side only; used for Whisper audio transcription of
# uploaded conversation recordings, see lib/ai/whisper.ts) ---
OPENAI_API_KEY=

# --- Transcription provider: "mock" (default here — free, local, no
# OpenAI credits needed, good for demos/dev) or "openai" (real Whisper,
# requires OPENAI_API_KEY + account credits). See
# lib/ai/transcription-provider.ts. ---
TRANSCRIPTION_PROVIDER=mock

# Note: the AI Conversation Analysis and AI Website Analysis text reports
# are local deterministic demo generators (lib/ai/conversation-analysis.ts,
# lib/ai/website-analysis.ts) — no API key or external AI service required
# for those. OPENAI_API_KEY above is only for turning uploaded audio into
# text via Whisper; the text analysis that follows still runs locally.

# --- WhatsApp integration ---
# "mock" (default — no external calls, no WhatsApp number or Wasender token
# needed, see lib/whatsapp/mock-provider.ts) or "wasender" (real WasenderAPI,
# requires WASENDER_API_TOKEN below). See lib/whatsapp/provider.ts.
WHATSAPP_PROVIDER=mock

# Shared secret the /api/whatsapp/webhook route requires on every request
# (header `x-webhook-secret`) — the mock provider sends it automatically.
# Generate any random string, e.g.: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=

# --- Real WasenderAPI (only needed once WHATSAPP_PROVIDER=wasender) ---
WASENDER_API_TOKEN=
WASENDER_PHONE_NUMBER=
